# Database
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# AI integrations (optional)
GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# SMTP (optional, required for email marketing sends)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_ENCRYPTION=tls

# Admin bootstrap and sessions (recommended for production)
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Admin

# Integración de acceso (Ecosistema): llave compartida servidor-a-servidor que usan
# las plataformas hermanas (ProfeTabla, Mis Proyectos) para verificar, por correo,
# el acceso vía GET /api/access/check (header x-access-key). NO usar prefijo VITE_/NEXT_PUBLIC_.
ACCESS_API_KEY=
