generator client {
  provider = "prisma-client-js"
  adapter  = "pg"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id           String @id @default(cuid())
  highlight    String
  title        String
  subtitle     String
  cta          String
  secondaryCta String
}

model Service {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  highlight       String?
  subtitle        String?
  description     String
  descriptionLong String?
  ctaText         String?
  seoTitle        String?
  seoDescription  String?
  iconName        String
  features        String[]
  active          Boolean @default(true)
}

model Product {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  description     String
  descriptionLong String?
  price           String
  ctaText         String?
  seoTitle        String?
  seoDescription  String?
  iconName        String
  active          Boolean @default(true)
}

model SiteConfig {
  id          String @id @default(cuid())
  name        String
  description String
  email       String
  address     String
  linkedin    String
  twitter     String?
}

model CmsSnapshot {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsSnapshotVersion {
  id           String   @id @default(cuid())
  snapshotId   String
  section      String
  data         Json
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    String?
  note         String?

  @@index([snapshotId, section, createdAt(sort: Desc)])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId    String?
  actorUsername  String?
  actorRole      String?
  action         String
  resource       String
  resourceId     String?
  section        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([resource, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model TranslationCache {
  key       String   @id
  targetLang String
  payload   Json
  provider  String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrivacyConsentAcceptance {
  id            String   @id @default(cuid())
  visitorId      String
  sessionId      String?
  policyVersion  String
  policyHash     String
  path           String?
  country        String?
  region         String?
  city           String?
  userAgent      String?
  metadata       Json?
  acceptedAt     DateTime @default(now())

  @@index([acceptedAt(sort: Desc)])
  @@index([visitorId, acceptedAt(sort: Desc)])
  @@index([policyVersion, acceptedAt(sort: Desc)])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  visitorId   String
  sessionId   String?
  eventType   String
  path        String?
  pageTitle   String?
  sectionId   String?
  durationMs  Int?
  country     String?
  region      String?
  city        String?
  referrer    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([sectionId, createdAt(sort: Desc)])
  @@index([country, createdAt(sort: Desc)])
}

model SimulatorRun {
  id             String   @id @default(cuid())
  visitorId      String
  sessionId      String?

  // Inputs capturados en el simulador
  sector         String
  orgType        String
  headcount      String
  maturity       String?
  orgContext     String?

  // Propuesta construida por IA (fases acumulativas + totales)
  proposal       Json
  headline       String?
  investmentMin  Int?
  investmentMax  Int?
  currency       String   @default("USD")
  providerUsed   String?

  // Datos de contacto (solo si el usuario solicita el envío de la propuesta)
  leadName       String?
  leadPhone      String?
  leadEmail      String?

  status         String   @default("completed") // completed | sent
  emailSentAt    DateTime?

  country        String?
  region         String?
  city           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([sector, createdAt(sort: Desc)])
  @@index([leadEmail, createdAt(sort: Desc)])
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  EDITOR
  ANALYST
}

enum AdminModule {
  DASHBOARD
  SITE_BUILDER
  SERVICES
  PRODUCTS
  LEADS
  DESIGN
  SEO
  MARKETING
  ANALYTICS
  INTEGRATIONS
  SETTINGS
  USERS
  BOOKINGS
  DOCUMENTS
  BI
  PROJECT_CONTROL
  COTIZADOR
  PROFE_TABLA
  MIS_PROYECTOS
  ADMIN_BRIDGE
}

// ─── Gestor Documental ───────────────────────────────────────────────────────

model DocCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String
  path        String        @unique
  parentId    String?
  parent      DocCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    DocCategory[] @relation("CategoryTree")
  level       Int           @default(0)
  description String?
  icon        String?
  color       String?
  sortOrder   Int           @default(0)
  permissions Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  documents   Document[]

  @@index([parentId])
  @@index([path])
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ShareEventType {
  EMAIL_SENT
  EMAIL_OPENED
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED
}

model Document {
  id           String         @id @default(cuid())
  title        String
  description  String?
  keywords     String[]
  fileName     String
  originalName String
  mimeType     String
  size         Int
  r2Key        String         @unique
  publicUrl    String?
  categoryId   String
  category     DocCategory    @relation(fields: [categoryId], references: [id])
  status       DocumentStatus @default(ACTIVE)
  version      Int            @default(1)
  uploadedBy   String
  uploadedByName String?
  aiProcessed  Boolean        @default(false)
  metadata     Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  versions     DocumentVersion[]
  reviews      DocReview[]
  comments     DocComment[]
  shares       DocShare[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([uploadedBy])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  r2Key      String
  size       Int
  uploadedBy String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([documentId, version])
}

model DocReview {
  id          String       @id @default(cuid())
  documentId  String
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy String
  requestedByName String?
  assignedTo  String?
  assignedToName  String?
  status      ReviewStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([documentId])
  @@index([status])
}

model DocComment {
  id         String       @id @default(cuid())
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  userName   String?
  content    String
  parentId   String?
  parent     DocComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies    DocComment[] @relation("CommentThread")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([documentId, createdAt(sort: Desc)])
}

model DocShare {
  id             String          @id @default(cuid())
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  shareToken     String          @unique @default(cuid())
  recipientEmail String
  recipientName  String?
  sentBy         String
  sentByName     String?
  subject        String?
  message        String?
  password       String?
  expiresAt      DateTime?
  maxViews       Int?
  viewCount      Int             @default(0)
  createdAt      DateTime        @default(now())
  events         DocShareEvent[]

  @@index([documentId])
  @@index([shareToken])
  @@index([recipientEmail])
}

model DocShareEvent {
  id        String         @id @default(cuid())
  shareId   String
  share     DocShare       @relation(fields: [shareId], references: [id], onDelete: Cascade)
  eventType ShareEventType
  ipAddress String?
  userAgent String?
  country   String?
  createdAt DateTime       @default(now())

  @@index([shareId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model AdminUser {
  id                    String                @id @default(cuid())
  username              String                @unique
  email                 String?               @unique
  displayName           String
  role                  AdminRole             @default(ADMIN)
  passwordHash          String
  active                Boolean               @default(true)
  passwordSetupRequired Boolean               @default(false)
  suspendedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lastLoginAt           DateTime?
  permissions           AdminUserPermission[]
  authTokens            AdminCredentialToken[]
  navigationLogs        AdminNavigationLog[]
}

model AdminUserPermission {
  id        String      @id @default(cuid())
  userId    String
  module    AdminModule
  canAccess Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      AdminUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([module, canAccess])
}

model AdminCredentialToken {
  id              String     @id @default(cuid())
  userId          String
  tokenHash       String     @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String?
  createdByName   String?
  purpose         String     @default("SETUP_PASSWORD")
  metadata        Json?
  createdAt       DateTime   @default(now())
  user            AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model AdminNavigationLog {
  id          String     @id @default(cuid())
  userId      String
  username    String
  role        AdminRole
  path        String
  action      String     @default("NAVIGATE")
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  user        AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
}

model ContactLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  requirement  String
  context      String?
  serviceSlug  String?
  path         String?
  country      String?
  region       String?
  city         String?
  status       String   @default("pending") // pending, read, replied, archived
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model MarketingEmailCampaign {
  id              String                  @id @default(cuid())
  name            String
  subject         String
  preheader       String?
  templateId      String                  @default("executive")
  bodyText        String?
  ctaLabel        String?
  ctaHref         String?
  renderedHtml    String?
  renderedText    String?
  fromName        String
  fromEmail       String
  previewOnly     Boolean                 @default(false)
  createdByUserId String?
  createdByName   String?
  sentCount       Int                     @default(0)
  failedCount     Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  recipients      MarketingEmailRecipient[]

  @@index([createdAt(sort: Desc)])
}

model MarketingEmailRecipient {
  id           String                @id @default(cuid())
  campaignId   String
  campaign     MarketingEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  status       String                @default("pending")
  messageId    String?
  failureReason String?
  sentAt       DateTime?
  openedAt     DateTime?
  lastOpenedAt DateTime?
  openCount    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
  @@index([openedAt])
  @@index([sentAt])
}

model Appointment {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String
  role            String
  industry        String
  employeeCount   String
  website         String?
  message         String
  startTime       DateTime
  endTime         DateTime
  googleEventId   String?
  status          String   @default("confirmed") // confirmed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startTime])
  @@index([email])
}

model AppointmentSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startTime, endTime])
  @@index([startTime])
}

// ============================================================
// Módulo BI (Algoritmo BI) — datasets analíticos gobernados en DB
// ============================================================
model BiConversation {
  id        String   @id
  userId    String
  title     String   @default("")
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model BiDataset {
  id          String   @id @default(cuid())
  key         String   @unique // p.ej. "insights", "prospectiva", "recomendaciones"
  title       String
  description String?
  category    String? // oferta | laboral | regional | workspace
  version     String   @default("1")
  meta        Json? // metadatos de calidad/trazabilidad
  data        Json // payload analítico (agregado)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
}

// ─── Project Control (tableros customizables tipo hoja de cálculo) ───────────

model PcBoard {
  id           String         @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  columns      Json           @default("[]") // PcColumn[]: { id, name, type, options?, width? }
  rows         Json           @default("[]") // PcRow[]:    { id, cells: { colId: value } }
  shareToken   String?        @unique // link público de solo lectura
  shareEnabled Boolean        @default(false)
  publicView   Json? // vista pública por defecto fijada por el propietario
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  shares       PcBoardShare[]

  @@index([ownerId, updatedAt(sort: Desc)])
}

model PcBoardShare {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  role      String   @default("VIEW") // VIEW | EDIT
  createdAt DateTime @default(now())
  board     PcBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

// ─── Cotizador (Ecosistema) ──────────────────────────────────────────────────
// Cada cotización se construye conversando con la IA, apoyada en dos fuentes:
// el catálogo de módulos con precios (QuoteCatalogItem, la única fuente de
// cifras) y la base de documentos de contexto (QuoteKnowledgeDoc, de donde la
// IA toma metodología, tono y antecedentes). La IA nunca inventa montos.

model QuoteCatalogItem {
  id           String   @id @default(cuid())
  code         String   @unique // NUCLEO, M01, M02… / SV01, SV02…
  name         String
  summary      String // qué resuelve, en 2-3 líneas
  category     String // Núcleo · Operación editorial · Comercial · Canal digital…
  template     String   @default("PRODUCTO") // PRODUCTO (plataforma modular) | SERVICIO (proyectos por unidad)
  unit         String? // para SERVICIO: curso, recurso, programa, estudio…
  kind         String   @default("MODULE") // CORE (obligatorio) | MODULE (opcional)
  price        Int // precio base en la moneda del catálogo
  currency     String   @default("COP")
  deliverables Int      @default(0)
  weeks        Float    @default(1) // esfuerzo en semanas
  defaultOn    Boolean  @default(true) // encendido por defecto en una cotización nueva
  active       Boolean  @default(true)
  tags         String[] @default([])
  detail       Json? // { entregables: string[], notas?: string }
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([category, sortOrder])
}

model QuoteKnowledgeDoc {
  id         String   @id @default(cuid())
  title      String
  kind       String   @default("REFERENCE") // METHODOLOGY | PRICING | CASE | TERMS | BRAND | REFERENCE
  sourceName String? // archivo original
  mimeType   String?
  content    String // texto plano extraído: es el contexto que lee la IA
  summary    String?
  charCount  Int      @default(0)
  active     Boolean  @default(true)
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, updatedAt(sort: Desc)])
  @@index([kind, updatedAt(sort: Desc)])
}

model Quote {
  id            String  @id @default(cuid())
  publicId      String  @unique // id no adivinable de la URL /c/:publicId
  ownerId       String // AdminUser.id
  status        String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  template      String  @default("PRODUCTO") // PRODUCTO | SERVICIO
  clientName    String
  clientContact String?
  clientEmail   String?
  sector        String?
  title         String
  subtitle      String?
  currency      String  @default("COP")

  content       Json // documento: secciones narrativas, cronograma, condiciones
  pricing       Json // { items: [{code,name,price,weeks,deliverables,on}], scale: [...] }
  discountScale Json?

  totalBase   Int       @default(0)
  totalFinal  Int       @default(0)
  weeks       Int       @default(0)
  moduleCount Int       @default(0)
  validDays   Int       @default(45)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients QuoteRecipient[]
  events     QuoteEvent[]
  messages   QuoteMessage[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model QuoteRecipient {
  id          String    @id @default(cuid())
  quoteId     String
  token       String    @unique // /c/:publicId?d=<token>
  name        String
  email       String?
  role        String?
  sentAt      DateTime?
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  openCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteEvent {
  id          String   @id @default(cuid())
  quoteId     String
  recipientId String?
  type        String // view | heartbeat | section | toggle | preset | pdf | cta
  sectionId   String?
  moduleCode  String?
  value       String?
  durationMs  Int?
  visitorId   String?
  sessionId   String?
  country     String?
  region      String?
  city        String?
  referrer    String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt(sort: Desc)])
  @@index([quoteId, type, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
}

model QuoteMessage {
  id        String   @id @default(cuid())
  quoteId   String
  role      String // user | assistant
  content   String
  meta      Json? // { providerUsed, patch }
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

/// Puente remoto con "Claudia" (agente local en la Mac del profe Andrés).
/// El equipo local NO expone puertos: consulta esta cola hacia afuera.
model ClaudiaJob {
  id        String    @id @default(cuid())
  status    String    @default("PENDING") // PENDING | TAKEN | DONE | ERROR | CANCELLED
  prompt    String
  project   String? // nombre/ruta del proyecto destino (vacío = Mi Mac)
  result    String?
  events    Json? // traza de herramientas ejecutadas
  createdBy String // correo de quien la pidió
  createdAt DateTime  @default(now())
  takenAt   DateTime?
  doneAt    DateTime?

  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
}

/// Latido del equipo local: para saber si Claudia está en línea.
model ClaudiaDevice {
  id       String   @id @default("default")
  lastSeen DateTime @updatedAt
  version  String?
  projects Json? // lista de proyectos disponibles
}

/// Licencias del plugin Learning Analytics para Moodle.
/// El código se firma con Ed25519 y se verifica en la plataforma del cliente,
/// por lo que esta tabla no interviene en la activación: sirve para emitir,
/// llevar registro y poder revocar.
model PluginLicence {
  id          String   @id @default(cuid())
  /// Identificador legible que viaja dentro del código firmado (campo "i").
  licenceId   String   @unique
  customer    String
  contactEmail String?
  /// Huella del wwwroot del cliente, o "*" si el código vale en cualquier sitio.
  siteHash    String
  /// Funcionalidades habilitadas. ["*"] concede el catálogo completo.
  features    Json
  /// Código firmado entregado al cliente.
  code        String
  issuedAt    DateTime @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedNote String?
  notes       String?
  /// Última vez que la plataforma del cliente revalidó.
  lastCheckAt DateTime?
  /// Versión del plugin declarada en la última revalidación.
  lastVersion String?
  /// Número de revalidaciones recibidas: indicio de uso real.
  checkCount  Int      @default(0)

  /// Analítica conversacional. Corre con nuestra clave de OpenAI, no con la
  /// del cliente, así que se habilita licencia por licencia.
  aiEnabled   Boolean  @default(false)
  /// Consultas permitidas al mes. El cupo se cuenta en consultas y no en
  /// tokens porque es lo único que el cliente puede prever.
  aiMonthlyQuota Int   @default(0)
  /// Modelo concreto para esta licencia. Vacío usa el de las integraciones.
  aiModel     String?
  /// Parametrización remota que viaja en la revalidación diaria. Permite
  /// cambiar el comportamiento del plugin sin publicar una versión nueva.
  config      Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checks      PluginLicenceCheck[]
  aiUsage     PluginAiUsage[]

  @@index([customer])
  @@index([siteHash])
  @@index([expiresAt])
  @@index([createdAt(sort: Desc)])
}

/// Registro de cada revalidación recibida desde una plataforma cliente.
/// Consumo mensual de analítica conversacional, una fila por licencia y mes.
/// Se lleva agregado y no consulta a consulta: el cupo se comprueba en cada
/// petición y una cuenta acumulada se resuelve con una sola lectura.
model PluginAiUsage {
  id          String   @id @default(cuid())
  licence     PluginLicence @relation(fields: [licenceDbId], references: [id], onDelete: Cascade)
  licenceDbId String
  /// Mes natural en formato AAAA-MM, en horario del servidor.
  period      String
  calls       Int      @default(0)
  /// Caracteres enviados y recibidos. Es una aproximación del coste, no una
  /// medida de tokens: sirve para ver qué licencia consume de verdad.
  chars       Int      @default(0)
  lastCallAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([licenceDbId, period])
  @@index([period])
}

model PluginLicenceCheck {
  id         String   @id @default(cuid())
  licence    PluginLicence @relation(fields: [licenceDbId], references: [id], onDelete: Cascade)
  licenceDbId String
  siteHash   String
  version    String?
  /// Respuesta que se devolvió: active | revoked | unknown.
  outcome    String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([licenceDbId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
