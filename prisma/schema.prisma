generator client {
  provider = "prisma-client-js"
  adapter  = "pg"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id           String @id @default(cuid())
  highlight    String
  title        String
  subtitle     String
  cta          String
  secondaryCta String
}

model Service {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  highlight       String?
  subtitle        String?
  description     String
  descriptionLong String?
  ctaText         String?
  seoTitle        String?
  seoDescription  String?
  iconName        String
  features        String[]
  active          Boolean @default(true)
}

model Product {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  description     String
  descriptionLong String?
  price           String
  ctaText         String?
  seoTitle        String?
  seoDescription  String?
  iconName        String
  active          Boolean @default(true)
}

model SiteConfig {
  id          String @id @default(cuid())
  name        String
  description String
  email       String
  address     String
  linkedin    String
  twitter     String?
}

model CmsSnapshot {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsSnapshotVersion {
  id           String   @id @default(cuid())
  snapshotId   String
  section      String
  data         Json
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    String?
  note         String?

  @@index([snapshotId, section, createdAt(sort: Desc)])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId    String?
  actorUsername  String?
  actorRole      String?
  action         String
  resource       String
  resourceId     String?
  section        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([resource, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model TranslationCache {
  key       String   @id
  targetLang String
  payload   Json
  provider  String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrivacyConsentAcceptance {
  id            String   @id @default(cuid())
  visitorId      String
  sessionId      String?
  policyVersion  String
  policyHash     String
  path           String?
  country        String?
  region         String?
  city           String?
  userAgent      String?
  metadata       Json?
  acceptedAt     DateTime @default(now())

  @@index([acceptedAt(sort: Desc)])
  @@index([visitorId, acceptedAt(sort: Desc)])
  @@index([policyVersion, acceptedAt(sort: Desc)])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  visitorId   String
  sessionId   String?
  eventType   String
  path        String?
  pageTitle   String?
  sectionId   String?
  durationMs  Int?
  country     String?
  region      String?
  city        String?
  referrer    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([sectionId, createdAt(sort: Desc)])
  @@index([country, createdAt(sort: Desc)])
}

model SimulatorRun {
  id             String   @id @default(cuid())
  visitorId      String
  sessionId      String?

  // Inputs capturados en el simulador
  sector         String
  orgType        String
  headcount      String
  maturity       String?
  orgContext     String?

  // Propuesta construida por IA (fases acumulativas + totales)
  proposal       Json
  headline       String?
  investmentMin  Int?
  investmentMax  Int?
  currency       String   @default("USD")
  providerUsed   String?

  // Datos de contacto (solo si el usuario solicita el envío de la propuesta)
  leadName       String?
  leadPhone      String?
  leadEmail      String?

  status         String   @default("completed") // completed | sent
  emailSentAt    DateTime?

  country        String?
  region         String?
  city           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([sector, createdAt(sort: Desc)])
  @@index([leadEmail, createdAt(sort: Desc)])
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  EDITOR
  ANALYST
}

enum AdminModule {
  DASHBOARD
  SITE_BUILDER
  SERVICES
  PRODUCTS
  LEADS
  DESIGN
  SEO
  MARKETING
  ANALYTICS
  INTEGRATIONS
  SETTINGS
  USERS
  BOOKINGS
  DOCUMENTS
  BI
  PROJECT_CONTROL
  PROFE_TABLA
  MIS_PROYECTOS
  ADMIN_BRIDGE
}

// ─── Gestor Documental ───────────────────────────────────────────────────────

model DocCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String
  path        String        @unique
  parentId    String?
  parent      DocCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    DocCategory[] @relation("CategoryTree")
  level       Int           @default(0)
  description String?
  icon        String?
  color       String?
  sortOrder   Int           @default(0)
  permissions Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  documents   Document[]

  @@index([parentId])
  @@index([path])
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ShareEventType {
  EMAIL_SENT
  EMAIL_OPENED
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED
}

model Document {
  id           String         @id @default(cuid())
  title        String
  description  String?
  keywords     String[]
  fileName     String
  originalName String
  mimeType     String
  size         Int
  r2Key        String         @unique
  publicUrl    String?
  categoryId   String
  category     DocCategory    @relation(fields: [categoryId], references: [id])
  status       DocumentStatus @default(ACTIVE)
  version      Int            @default(1)
  uploadedBy   String
  uploadedByName String?
  aiProcessed  Boolean        @default(false)
  metadata     Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  versions     DocumentVersion[]
  reviews      DocReview[]
  comments     DocComment[]
  shares       DocShare[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([uploadedBy])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  r2Key      String
  size       Int
  uploadedBy String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([documentId, version])
}

model DocReview {
  id          String       @id @default(cuid())
  documentId  String
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy String
  requestedByName String?
  assignedTo  String?
  assignedToName  String?
  status      ReviewStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([documentId])
  @@index([status])
}

model DocComment {
  id         String       @id @default(cuid())
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  userName   String?
  content    String
  parentId   String?
  parent     DocComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies    DocComment[] @relation("CommentThread")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([documentId, createdAt(sort: Desc)])
}

model DocShare {
  id             String          @id @default(cuid())
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  shareToken     String          @unique @default(cuid())
  recipientEmail String
  recipientName  String?
  sentBy         String
  sentByName     String?
  subject        String?
  message        String?
  expiresAt      DateTime?
  maxViews       Int?
  viewCount      Int             @default(0)
  createdAt      DateTime        @default(now())
  events         DocShareEvent[]

  @@index([documentId])
  @@index([shareToken])
  @@index([recipientEmail])
}

model DocShareEvent {
  id        String         @id @default(cuid())
  shareId   String
  share     DocShare       @relation(fields: [shareId], references: [id], onDelete: Cascade)
  eventType ShareEventType
  ipAddress String?
  userAgent String?
  country   String?
  createdAt DateTime       @default(now())

  @@index([shareId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model AdminUser {
  id                    String                @id @default(cuid())
  username              String                @unique
  email                 String?               @unique
  displayName           String
  role                  AdminRole             @default(ADMIN)
  passwordHash          String
  active                Boolean               @default(true)
  passwordSetupRequired Boolean               @default(false)
  suspendedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lastLoginAt           DateTime?
  permissions           AdminUserPermission[]
  authTokens            AdminCredentialToken[]
  navigationLogs        AdminNavigationLog[]
}

model AdminUserPermission {
  id        String      @id @default(cuid())
  userId    String
  module    AdminModule
  canAccess Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      AdminUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([module, canAccess])
}

model AdminCredentialToken {
  id              String     @id @default(cuid())
  userId          String
  tokenHash       String     @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String?
  createdByName   String?
  purpose         String     @default("SETUP_PASSWORD")
  metadata        Json?
  createdAt       DateTime   @default(now())
  user            AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model AdminNavigationLog {
  id          String     @id @default(cuid())
  userId      String
  username    String
  role        AdminRole
  path        String
  action      String     @default("NAVIGATE")
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  user        AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
}

model ContactLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  requirement  String
  context      String?
  serviceSlug  String?
  path         String?
  country      String?
  region       String?
  city         String?
  status       String   @default("pending") // pending, read, replied, archived
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model MarketingEmailCampaign {
  id              String                  @id @default(cuid())
  name            String
  subject         String
  preheader       String?
  templateId      String                  @default("executive")
  bodyText        String?
  ctaLabel        String?
  ctaHref         String?
  renderedHtml    String?
  renderedText    String?
  fromName        String
  fromEmail       String
  previewOnly     Boolean                 @default(false)
  createdByUserId String?
  createdByName   String?
  sentCount       Int                     @default(0)
  failedCount     Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  recipients      MarketingEmailRecipient[]

  @@index([createdAt(sort: Desc)])
}

model MarketingEmailRecipient {
  id           String                @id @default(cuid())
  campaignId   String
  campaign     MarketingEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  status       String                @default("pending")
  messageId    String?
  failureReason String?
  sentAt       DateTime?
  openedAt     DateTime?
  lastOpenedAt DateTime?
  openCount    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
  @@index([openedAt])
  @@index([sentAt])
}

model Appointment {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String
  role            String
  industry        String
  employeeCount   String
  website         String?
  message         String
  startTime       DateTime
  endTime         DateTime
  googleEventId   String?
  status          String   @default("confirmed") // confirmed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startTime])
  @@index([email])
}

model AppointmentSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startTime, endTime])
  @@index([startTime])
}

// ============================================================
// Módulo BI (Algoritmo BI) — datasets analíticos gobernados en DB
// ============================================================
model BiConversation {
  id        String   @id
  userId    String
  title     String   @default("")
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model BiDataset {
  id          String   @id @default(cuid())
  key         String   @unique // p.ej. "insights", "prospectiva", "recomendaciones"
  title       String
  description String?
  category    String? // oferta | laboral | regional | workspace
  version     String   @default("1")
  meta        Json? // metadatos de calidad/trazabilidad
  data        Json // payload analítico (agregado)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
}

// ─── Project Control (tableros customizables tipo hoja de cálculo) ───────────

model PcBoard {
  id           String         @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  columns      Json           @default("[]") // PcColumn[]: { id, name, type, options?, width? }
  rows         Json           @default("[]") // PcRow[]:    { id, cells: { colId: value } }
  shareToken   String?        @unique // link público de solo lectura
  shareEnabled Boolean        @default(false)
  publicView   Json? // vista pública por defecto fijada por el propietario
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  shares       PcBoardShare[]

  @@index([ownerId, updatedAt(sort: Desc)])
}

model PcBoardShare {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  role      String   @default("VIEW") // VIEW | EDIT
  createdAt DateTime @default(now())
  board     PcBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}
