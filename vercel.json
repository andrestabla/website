{
  "rewrites": [
    {
      "source": "/cotizaciones/upc-2026",
      "destination": "/cotizaciones/upc-2026/Propuesta-UPC-2026.html"
    },
    {
      "source": "/cotizaciones/unisinu-2026",
      "destination": "/cotizaciones/unisinu-2026/index.html"
    },
    {
      "source": "/cotizaciones/cardioinfantil-2026",
      "destination": "/cotizaciones/cardioinfantil-2026/index.html"
    },
    {
      "source": "/cotizaciones/4shine-2026",
      "destination": "/cotizaciones/4shine-2026/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/ova/:publicId/a/:path*",
      "destination": "/api/learning/asset?id=:publicId&path=:path*"
    },
    {
      "source": "/ova/:publicId",
      "destination": "/api/learning/view?id=:publicId"
    },
    {
      "source": "/assets/landing/education.png",
      "destination": "/assets/landing/education.webp"
    },
    {
      "source": "/assets/landing/corporate.png",
      "destination": "/assets/landing/corporate.webp"
    },
    {
      "source": "/assets/landing/tuprofe-mockup.png",
      "destination": "/assets/landing/tuprofe-mockup.webp"
    },
    {
      "source": "/back-ecosistema.jpg",
      "destination": "/back-ecosistema.webp"
    },
    {
      "source": "/back-project-control.jpg",
      "destination": "/back-project-control.webp"
    },
    {
      "source": "/bi-login-bg.jpg",
      "destination": "/bi-login-bg.webp"
    },
    {
      "source": "/back-learning.jpg",
      "destination": "/back-learning.webp"
    },
    {
      "source": "/assets/landing/hazlo-tu-mismo-demo.gif",
      "destination": "/assets/landing/hazlo-tu-mismo-demo.webp"
    },
    {
      "source": "/((?!api/)(?!@)(?!__)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/quotes/pdf.ts": {
      "memory": 3008,
      "maxDuration": 60
    },
    "api/learning/export.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
